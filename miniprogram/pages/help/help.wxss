.help-card { padding: 24rpx; margin-bottom: 20rpx; }
.help-title { font-size: 30rpx; margin-bottom: 16rpx; }
.help-step {
  display: flex;
  gap: 16rpx;
  padding: 10rpx 0;
  font-size: 26rpx;
  line-height: 1.6;
}
.step-num {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--accent-soft);
  color: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  margin-top: 2rpx;
}
