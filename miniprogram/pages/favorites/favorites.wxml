<view class="page {{theme === 'warm' ? 'warm' : ''}}">

  <view class="empty card" wx:if="{{!items.length}}">
    <text class="strong">还没有收藏课程</text>
    <text class="muted">在课表里点开课程卡片，点击「收藏」即可加入</text>
  </view>

  <view class="fav-list" wx:if="{{items.length}}">
    <view class="fav-card card" wx:for="{{items}}" wx:key="title">
      <view class="fav-head">
        <view class="fav-title">
          <text class="strong">{{item.title}}</text>
          <text class="muted">{{item.teachers || '未标注教师'}} · {{item.credit}} 学分</text>
        </view>
        <text class="fav-remove" data-title="{{item.title}}" bindtap="onRemove">取消收藏</text>
      </view>
      <view class="fav-event" wx:for="{{item.events}}" wx:for-item="ev" wx:key="index">
        <text class="fav-ev-time strong">{{ev.dayName}} {{ev.timeText}}</text>
        <text class="fav-ev-room muted">{{ev.campus}} · {{ev.room}}</text>
        <text class="fav-ev-weeks muted">{{ev.weeksText}}</text>
      </view>
    </view>
  </view>

</view>
